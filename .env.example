# FinSight — Environment Variables
# Copy this file to .env and fill in the actual values

# === PostgreSQL Configuration ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finsight
POSTGRES_USER=finsight_user
POSTGRES_PASSWORD=finsight_secure_password_change_me

# === MongoDB Configuration ===
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=finsight_analytics

# === JWT Authentication ===
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ← Fresh from §6.3 endpoints MAP
REFRESH_TOKEN_EXPIRE_DAYS=7

# === CORS (Frontend URL) ===
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173; http://test.local:5173

# === Application Features ===
ENABLE_ML_CATEGORIZATION=true
ENABLE_FRAUD_DETECTION=true
ENABLE_AUTO_SWEEP=true
ENABLE_NOT_QUEUE=true

# === Budget Health Score Weights (0-100 total) ===
BUDGET_ADHERENCE_WEIGHT=40
SAVINGS_RATE_WEIGHT=30
VARIALCE_WEIGHT=30

# === BankLending/FinTechLoanDefaults ===
# FinTech Lending features (optional):
ENABLE_LOAN_TRACKING=true
DEFAULT_CL_DEFAULT_RATE=3.5

# === LDAP Auth (optional) ===
LDAP_ENABLED=false
LDAP_SERVER=ldap://your-ldap-server
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_SEARCH_FILTER=uid=%s

# === Redis (for caching & job queues) ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# === File Storage ===
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=/app/uploads

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# === Rate Limiting ===
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_STRONG_PASSWORD_MIN_SCORE=3

# === Banking / Payments (if real integration later) ===
ENABLE_PAYMENT_GATEWAY=false
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_SECRET=

# === Environment ===
ENVIRONMENT=development  # development | staging | production

# === Email Configuration (for notifications) ===
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@finsight.local

# === SMS Configuration (optional) ===
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# === Security ===
Bcrypt_Cost=12
SESSION_TIMEOUT_SECONDS=3600  # 1 hour default

# === Audit Log Retention ===
AUDIT_LOG_RETENTION_DAYS=90

# === MongoDB Session Timeout ===
MONGO_SESSION_TIMEOUT=300000  # 5 minutes

# === Flask+-+-+-+-Server+Configuration ===
FLASK_SERVER_HOST=0.0.0.0
FLASK_SERVER_PORT=8000

# === Frontend Proxy ===
FRONTEND_PROXY=/api

# === Metrics (Prometheus) ===
ENABLE_METRICS=false
METRICS_PORT=9090

# === OK: Next steps for backend/core/security/deps/exceptions, models/schemas/routes/services, postgres/mongo, alembic/migrations, procedures.sql, views.sql, indexes.sql, ML/ml/, sync/, tests/conftest.py, agents/cluster/ nodes.yaml, docs/, Authentication/JWT, Notification/notification.py, Billing/tb_intacct, Billing/billing_service.py, Billing/billing_report.py, Billing/rautlbilling_service.py, Billing/billing.yy, Billing/billing_service.sql, Billing/billing_config.sql

NEXT_STEPS_BACKEND=core/security/deps/exceptions
NEXT_STEPS_MODELS=scopex/schemas/routes/services
NEXT_STEPS_DB=postgres/mongo
NEXT_STEPS_MIGRATIONS=alembic/migrations
NEXT_STEPS_SQL=procedures/views/indexes
NEXT_STEPS_ML=ml/
NEXT_STEPS_SYNC=sync/
NEXT_STEPS_TESTS=tests/conftest.py
NEXT_STEPS_AGENTS=cluster/ nodes.yaml
NEXT_STEPS_DOCS=docs/
NEXT_STEPS_AUTH=JWT
NEXT_STEPS_NOTIFICATIONS=notification.py
NEXT_STEPS_BILLING=tb_intacct billing_service.py billing_report.py rautlbilling_service.py billing.yy billing_service.sql billing_config.sql

# ← FIXED ACCESS_TOKEN_EXP below
ACCESS_TOKEN_EXPIRE_MINUTES=15